# Learn fleet config (node-7) — the Stage F cutover un-repoint.
# STAGED at WP-F0c; applied at WP-F1 (gated on the founder's "CUTOVER APPROVED"):
#   cp learn.env learn.env.pre-stage-f.bak && cp learn.env.stage-f-unrepoint learn.env
#
# What changes vs the pre-cutover learn.env, and why:
#  * SERVICES_ROOT / DP_VAR_DIR return to this tree — the dp-v0-live worktree
#    retires at F1. Kept explicit (the defaults would resolve the same) so the
#    reader sees a choice, not an accident.
#  * The five STORAGE_* data pins retire: with code and data in one tree again,
#    run.sh's own defaults resolve to exactly the live paths the pins named.
#    The repoint moved code, never data (Stage E); the coupling the pins
#    bridged dissolves here, per the Stage E "Noticed" checklist.
#  * ASR_BACKEND / ASR_LANGUAGE retire: v0 knobs the rebuilt DP does not read.
#    The v1 whisper server pins large-v3/cuda/fp16 in code — a deliberate
#    dialect change from v0's base/cpu/int8 (Stage B/C), not a config choice.
#  * DP_SUPERVISOR=1: the deploy owns the model-server fleet (manifest GPUs 2-7
#    + ocr on CPU). This same opt-in arms DP's boot-time VLM identity probe.
#  * VLM_URL: clipcap's captioner endpoint — run_vllm.sh serves the pinned
#    Qwen3-VL-32B on loopback :8161 (port map: STACK.md). VLM_API_KEY and
#    VLM_TIMEOUT_S stay at their code defaults (loopback, no key; 120 s).
#  * HF_TOKEN passthrough (the Stage B carry): deliberately NOT set here — the
#    fleet resolves hub auth from ~/.cache/huggingface/token (present on
#    node-7), and a secret does not belong in a committed staging file. The
#    deploy owns the fact and its location; recorded in the Stage F worklog.

# Recording's client timeout for the DP /ingest push. The v1 DP ACKs 202 and
# processes async, so the inline-processing reason for 120 s is gone; the value
# stays as a generous transport ceiling.
RECORDING_HTTP_TIMEOUT=120

SERVICES_ROOT=/home/ubuntu/nmn/continual_learning/product/services
DP_VAR_DIR=/home/ubuntu/nmn/continual_learning/product/services/data-processing/var

DP_SUPERVISOR=1
VLM_URL=http://127.0.0.1:8161
